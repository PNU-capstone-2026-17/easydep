# Nvidia NIM (OpenAI 호환) 자격증명 — 이 파일을 .env로 복사해 값을 채우세요.
API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BASE_URL=https://integrate.api.nvidia.com/v1
# 요구사항 분석 에이전트 기본 모델. NIM에서 사용 가능한 값으로 교체하세요.
MODEL=openai/gpt-oss-120b

# --- 요구사항 분석 에이전트 옵션 ---
# BERT FR/NFR 검증 노드 사용 여부. false면 torch 로드를 건너뛰고 LLM 분류만 사용
# (경량 배포/메모리 제약 시 유용).
ENABLE_BERT_VERIFY=true
# 2~4단계(액터/유스케이스/명세/다이어그램) 노드 실행 여부. 웹 UI로 4단계 전체를 보려면 true.
ENABLE_PIPELINE_STUBS=false
# 대화형 게이트(step1 clarify 질문 + 각 스텝 말미 피드백 루프) 사용 여부.
# true면 단계별로 되묻는 대화형, false면 전체 파이프라인을 한 번에 실행(자율). 웹 UI는 둘 다 지원.
ENABLE_FEEDBACK_GATES=false
