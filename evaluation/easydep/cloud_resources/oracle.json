{
  "aws-public-load-balancer": {
    "requiredNodes": ["loadBalancer", "subnet", "network"],
    "requiredEdges": [["loadBalancer", "subnet"], ["subnet", "network"]],
    "evidence": [
      "claims.json: aws loadBalancer->subnet existence required",
      "claims.json: aws subnet->network existence required"
    ]
  },
  "azure-docker-vm": {
    "requiredNodes": ["vm", "nic", "subnet", "network"],
    "requiredEdges": [["vm", "nic"], ["nic", "subnet"], ["subnet", "network"]],
    "evidence": [
      "claims.json: azure vm->nic existence required",
      "claims.json: azure nic->subnet existence required",
      "claims.json: azure subnet->network existence required"
    ]
  },
  "gcp-docker-vm": {
    "requiredNodes": ["vm", "nic", "disk"],
    "requiredEdges": [["vm", "nic"], ["vm", "disk"]],
    "evidence": [
      "claims.json: gcp vm->nic existence required",
      "claims.json: gcp vm->disk existence required"
    ]
  }
}
