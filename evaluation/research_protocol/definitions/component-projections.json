{
  "schemaVersion": "easydep-component-projections/v1",
  "status": "development-candidate",
  "scope": "docker-on-vm-http-with-l4-ingress",
  "deltas": [
    {
      "id": "persistent-storage",
      "controlCapability": "ephemeral-application-data",
      "treatmentCapabilities": ["persistent-block-storage", "compute-storage-attachment", "guest-volume-mount"],
      "realizations": {
        "aws": {
          "components": [
            {"id":"disk","terraformKind":"resource","terraformType":"aws_ebs_volume"},
            {"id":"attachment","terraformKind":"resource","terraformType":"aws_volume_attachment"},
            {"id":"mount","terraformKind":"guestConfiguration"}
          ],
          "relations": [
            {"from":"attachment","to":"disk","cardinality":"one-to-one"},
            {"from":"attachment","to":"vm","cardinality":"one-to-one"},
            {"from":"disk","to":"vm","constraint":"same-availability-zone"},
            {"from":"mount","to":"attachment","constraint":"device-must-be-formatted-and-mounted"}
          ],
          "evidence": [
            "https://docs.aws.amazon.com/ebs/latest/userguide/ebs-attaching-volume.html",
            "https://docs.aws.amazon.com/ebs/latest/userguide/ebs-using-volumes.html",
            "https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/volume_attachment"
          ]
        },
        "azure": {
          "components": [
            {"id":"disk","terraformKind":"resource","terraformType":"azurerm_managed_disk"},
            {"id":"attachment","terraformKind":"resource","terraformType":"azurerm_virtual_machine_data_disk_attachment"},
            {"id":"mount","terraformKind":"guestConfiguration"}
          ],
          "relations": [
            {"from":"attachment","to":"disk","cardinality":"one-to-one"},
            {"from":"attachment","to":"vm","cardinality":"one-to-one"},
            {"from":"mount","to":"attachment","constraint":"device-must-be-formatted-and-mounted"}
          ],
          "evidence": [
            "https://learn.microsoft.com/en-us/azure/virtual-machines/linux/attach-disk-portal",
            "https://registry.terraform.io/providers/hashicorp/azurerm/latest/docs/resources/virtual_machine_data_disk_attachment"
          ]
        },
        "gcp": {
          "components": [
            {"id":"disk","terraformKind":"resource","terraformType":"google_compute_disk"},
            {"id":"attachment","terraformKind":"resourceOrNestedBlock","terraformType":"google_compute_attached_disk|google_compute_instance.attached_disk"},
            {"id":"mount","terraformKind":"guestConfiguration"}
          ],
          "relations": [
            {"from":"attachment","to":"disk","cardinality":"one-to-one"},
            {"from":"attachment","to":"vm","cardinality":"one-to-one"},
            {"from":"mount","to":"attachment","constraint":"device-must-be-formatted-and-mounted"}
          ],
          "evidence": [
            "https://cloud.google.com/compute/docs/disks/attach-disks",
            "https://registry.terraform.io/providers/hashicorp/google/latest/docs/resources/compute_attached_disk"
          ]
        }
      }
    },
    {
      "id": "load-balanced-multi-vm",
      "controlCapability": "single-vm-ingress",
      "treatmentCapabilities": ["multi-zone-compute", "load-balanced-ingress", "health-routed-backend"],
      "realizations": {
        "aws": {
          "components": [
            {"id":"loadBalancer","terraformKind":"resource","terraformType":"aws_lb"},
            {"id":"listener","terraformKind":"resource","terraformType":"aws_lb_listener"},
            {"id":"backendGroup","terraformKind":"resource","terraformType":"aws_lb_target_group"},
            {"id":"backendMembership","terraformKind":"resource","terraformType":"aws_lb_target_group_attachment"}
          ],
          "relations": [
            {"from":"loadBalancer","to":"subnet","cardinality":"one-to-many","constraint":"one-or-more-enabled-zones"},
            {"from":"listener","to":"loadBalancer","cardinality":"many-to-one"},
            {"from":"listener","to":"backendGroup","cardinality":"many-to-one"},
            {"from":"backendMembership","to":"backendGroup","cardinality":"many-to-one"},
            {"from":"backendMembership","to":"vm","cardinality":"many-to-one"}
          ],
          "evidence": [
            "https://docs.aws.amazon.com/elasticloadbalancing/latest/network/network-load-balancers.html",
            "https://docs.aws.amazon.com/elasticloadbalancing/latest/network/load-balancer-target-groups.html",
            "https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/lb"
          ]
        },
        "azure": {
          "components": [
            {"id":"loadBalancer","terraformKind":"resource","terraformType":"azurerm_lb"},
            {"id":"frontend","terraformKind":"nestedBlock","terraformType":"azurerm_lb.frontend_ip_configuration"},
            {"id":"backendPool","terraformKind":"resource","terraformType":"azurerm_lb_backend_address_pool"},
            {"id":"probe","terraformKind":"resource","terraformType":"azurerm_lb_probe"},
            {"id":"rule","terraformKind":"resource","terraformType":"azurerm_lb_rule"},
            {"id":"backendMembership","terraformKind":"resource","terraformType":"azurerm_network_interface_backend_address_pool_association"}
          ],
          "relations": [
            {"from":"frontend","to":"publicIp","cardinality":"many-to-one"},
            {"from":"backendPool","to":"loadBalancer","cardinality":"many-to-one"},
            {"from":"probe","to":"loadBalancer","cardinality":"many-to-one"},
            {"from":"rule","to":"loadBalancer","cardinality":"many-to-one"},
            {"from":"rule","to":"backendPool","cardinality":"many-to-one"},
            {"from":"rule","to":"probe","cardinality":"many-to-one"},
            {"from":"backendMembership","to":"backendPool","cardinality":"many-to-one"}
          ],
          "evidence": [
            "https://learn.microsoft.com/en-us/azure/load-balancer/components",
            "https://learn.microsoft.com/en-us/azure/load-balancer/load-balancer-overview",
            "https://registry.terraform.io/providers/hashicorp/azurerm/latest/docs/resources/lb"
          ]
        },
        "gcp": {
          "components": [
            {"id":"forwardingRule","terraformKind":"resource","terraformType":"google_compute_forwarding_rule"},
            {"id":"backendService","terraformKind":"resource","terraformType":"google_compute_region_backend_service"},
            {"id":"backendGroup","terraformKind":"resource","terraformType":"google_compute_instance_group"},
            {"id":"healthCheck","terraformKind":"resource","terraformType":"google_compute_region_health_check"}
          ],
          "relations": [
            {"from":"forwardingRule","to":"backendService","cardinality":"many-to-one"},
            {"from":"backendService","to":"backendGroup","cardinality":"many-to-many"},
            {"from":"backendService","to":"healthCheck","cardinality":"many-to-many"},
            {"from":"backendGroup","to":"vm","cardinality":"many-to-many"}
          ],
          "evidence": [
            "https://cloud.google.com/load-balancing/docs/network/networklb-backend-service",
            "https://registry.terraform.io/providers/hashicorp/google/latest/docs/resources/compute_forwarding_rule",
            "https://registry.terraform.io/providers/hashicorp/google/latest/docs/resources/compute_region_backend_service"
          ]
        }
      }
    },
    {
      "id": "https-termination",
      "scopeStatus": "retired-evaluation-only",
      "controlCapability": "http-load-balanced-ingress",
      "treatmentCapabilities": ["https-load-balanced-ingress", "tls-termination", "certificate-binding"],
      "fixedCapabilities": ["multi-zone-compute", "load-balanced-ingress", "health-routed-backend"],
      "realizations": {
        "aws": {
          "components": [
            {"id":"httpsListener","terraformKind":"resource","terraformType":"aws_lb_listener"},
            {"id":"certificate","terraformKind":"resourceOrDataSource","terraformType":"aws_acm_certificate|data.aws_acm_certificate"}
          ],
          "relations": [
            {"from":"httpsListener","to":"loadBalancer","cardinality":"many-to-one"},
            {"from":"httpsListener","to":"certificate","cardinality":"many-to-many","constraint":"exactly-one-default-certificate"}
          ],
          "evidence": [
            "https://docs.aws.amazon.com/elasticloadbalancing/latest/application/create-https-listener.html",
            "https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/lb_listener"
          ]
        },
        "azure": {
          "components": [
            {"id":"httpsListener","terraformKind":"nestedBlock","terraformType":"azurerm_application_gateway.http_listener"},
            {"id":"certificate","terraformKind":"nestedBlock","terraformType":"azurerm_application_gateway.ssl_certificate"}
          ],
          "relations": [
            {"from":"httpsListener","to":"gateway","cardinality":"many-to-one"},
            {"from":"httpsListener","to":"certificate","cardinality":"many-to-one"}
          ],
          "evidence": [
            "https://learn.microsoft.com/en-us/azure/application-gateway/ssl-overview",
            "https://registry.terraform.io/providers/hashicorp/azurerm/latest/docs/resources/application_gateway"
          ]
        },
        "gcp": {
          "components": [
            {"id":"httpsProxy","terraformKind":"resource","terraformType":"google_compute_target_https_proxy"},
            {"id":"certificate","terraformKind":"resource","terraformType":"google_compute_ssl_certificate|google_compute_managed_ssl_certificate"}
          ],
          "relations": [
            {"from":"forwardingRule","to":"httpsProxy","cardinality":"many-to-one"},
            {"from":"httpsProxy","to":"urlMap","cardinality":"many-to-one"},
            {"from":"httpsProxy","to":"certificate","cardinality":"many-to-many"}
          ],
          "evidence": [
            "https://cloud.google.com/load-balancing/docs/https",
            "https://registry.terraform.io/providers/hashicorp/google/latest/docs/resources/compute_region_ssl_certificate"
          ]
        }
      }
    }
  ]
}
