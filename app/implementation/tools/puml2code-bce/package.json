{
 "name": "@easydep/puml2code-bce",
 "version": "0.2.0",
 "description": "EasyDep BCE PlantUML to Java skeleton generator, forked from jupe/puml2code",
  "main": "src/index.js",
 "bin": {
 "puml2code-bce": "./bin/puml2code"
  },
  "scripts": {
    "cli": "node src/cli.js",
