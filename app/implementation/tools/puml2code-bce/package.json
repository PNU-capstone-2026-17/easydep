  "author": "Jussi Vatjus-Anttila",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jupe/puml2code/issues"
  },
  "homepage": "https://github.com/jupe/puml2code#readme",
  "dependencies": {
    "bluebird": "^3.7.2",
    "camelcase": "^5.2.0",
    "commander": "^4.1.1",
    "debug": "^4.3.4",
    "handlebars": "^4.1.1",
    "lodash": "^4.17.21",
    "pegjs": "^0.10.0"
  }
}
