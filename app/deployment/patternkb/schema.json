{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "patternkb 설계 패턴 산문 코퍼스",
  "type": "object",
  "required": ["docs"],
  "properties": {
    "docs": {
      "type": "array",
      "items": { "$ref": "#/$defs/doc" }
    },
    "_coverage": { "type": "object" },
    "_source": { "type": "array" }
  },
  "$defs": {
    "doc": {
      "type": "object",
      "required": ["id", "title", "path", "source", "section", "license", "attribution", "url", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "path": {
          "type": "string",
          "description": "원본 저장소 기준 경로 — 인용의 좌표다."
        },
        "source": { "enum": ["ms-architecture-center", "twelve-factor", "azure-well-architected"] },
        "section": {
          "enum": [
            "patterns",
            "architecture-styles",
            "design-principles",
            "best-practices",
            "twelve-factor",
            "well-architected"
          ]
        },
        "license": {
          "enum": ["CC-BY-4.0", "MIT"],
          "description": "문서 단위로 담는다 — 인용을 내보낼 때 함께 나가야 한다."
        },
        "attribution": {
          "type": "string",
          "description": "저작자 표시. CC-BY의 필수 조건이라 데이터에서 떼면 안 된다."
        },
        "url": { "type": "string" },
        "text": {
          "type": "string",
          "description": "frontmatter를 뗀 본문 산문. 검색·인용 대상."
        }
      }
    }
  }
}
