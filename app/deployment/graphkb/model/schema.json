{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scenfit/graphkb/schema.json",
  "title": "graphkb dependency graph",
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "layer",
          "provider",
          "kind",
          "display_name",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "core",
              "vendor"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type",
          "via_property",
          "required",
          "cardinality",
          "evidence",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "references",
              "contained_in",
              "equivalent_to"
            ]
          },
          "via_property": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "cardinality": {
            "enum": [
              "one",
              "many"
            ]
          },
          "evidence": {
            "enum": [
              "relationshipRef",
              "cdk-oob",
              "swagger-field",
              "heuristic",
              "arm-id",
              "arm-hierarchy",
              "bicep-ref",
              "kcc-ref",
              "cb-spider-driver",
              "human-review"
            ],
            "description": "관계를 알아낸 방법. human-review는 소스에 있는데 파서가 못 뽑아 사람이 직접 채운 것으로, graphkb/reviewed/*.json에 이유가 적혀 있다."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reviewed": {
            "type": "boolean",
            "description": "사람이 눈으로 보고 확인한 관계. graphkb/reviewed/*.json에서 온다."
          }
        }
      }
    },
    "_source": {
      "type": "array",
      "description": "이 산출물이 어느 원본에서 나왔는지. 소스마다 한 항목. 고정 불가 소스(AWS CFN zip)는 sha256이 유일한 식별자다 — kbcommon/sources.py 참조.",
      "items": {
        "type": "object",
        "required": [
          "sha256"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "kbcommon/sources.py의 키"
          },
          "pin_kind": {
            "enum": [
              "tag",
              "commit",
              "digest",
              "bundled"
            ]
          },
          "pin": {
            "type": "string",
            "description": "태그명·커밋 SHA. digest 소스는 '(고정 불가)'"
          },
          "url": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "fetched_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_modified": {
            "type": [
              "string",
              "null"
            ]
          },
          "etag": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_file": {
            "type": "boolean"
          },
          "files": {
            "type": "integer",
            "description": "묶음 소스에서 실제로 읽은 파일 수"
          }
        }
      }
    }
  }
}
