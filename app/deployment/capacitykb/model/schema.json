{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scenfit/capacitykb/schema.json",
  "title": "capacitykb resource capacity / constraint records",
  "type": "object",
  "required": [
    "constraints",
    "quotas"
  ],
  "additionalProperties": false,
  "properties": {
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type_id",
          "property",
          "kind",
          "value",
          "conditional",
          "evidence",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "type_id": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "min",
              "max",
              "min_length",
              "max_length",
              "min_items",
              "max_items",
              "pattern",
              "enum",
              "default",
              "required",
              "mutability"
            ]
          },
          "value": {},
          "value_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "conditional": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "enum": [
              "cfn-schema",
              "cfn-description",
              "bicep-type",
              "bicep-flags",
              "crd-schema",
              "crd-description",
              "swagger-field",
              "curated",
              "heuristic"
            ]
          },
          "basis": {
            "type": "string",
            "enum": ["stated", "inferred"],
            "description": "근거의 성격. stated는 원본이 그렇게 적어 놓은 것, inferred는 우리가 이름·산문·구조에서 짐작한 것이다. evidence 라벨에서 정해지며 라벨 하나에 성격 하나가 규칙이다(kbcommon/basis.py). 예전의 confidence(0.5~1.0)를 대신한다 — 그 숫자는 척도의 정의가 없었다."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "mutability"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "enum": [
                    "create_only",
                    "conditional_create_only",
                    "read_only"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "required"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "quotas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "name",
          "source_doc",
          "evidence",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "default": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "maximum": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "type_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_doc": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "enum": [
              "azure-limits-doc",
              "azure-limits-note",
              "curated",
              "heuristic"
            ]
          },
          "basis": {
            "type": "string",
            "enum": ["stated", "inferred"],
            "description": "근거의 성격. stated는 원본이 그렇게 적어 놓은 것, inferred는 우리가 이름·산문·구조에서 짐작한 것이다. evidence 라벨에서 정해지며 라벨 하나에 성격 하나가 규칙이다(kbcommon/basis.py). 예전의 confidence(0.5~1.0)를 대신한다 — 그 숫자는 척도의 정의가 없었다."
          }
        }
      }
    },
    "_coverage": {
      "type": "array",
      "description": "무엇을 훑었는가. 이게 없으면 '제약 없음'과 '안 봤음'이 구분되지 않는다 — 실측상 graphkb가 아는 벤더 타입 5,547종 중 3,634종에 제약 레코드가 없고 GCP 527종은 전부 미수집이다.",
      "items": {
        "type": "object",
        "required": ["provider"],
        "properties": {
          "provider": {"type": "string"},
          "scope": {
            "type": "array",
            "items": {"type": "string"},
            "description": "훑은 네임스페이스. 없으면 그 프로바이더 전체를 훑었다는 뜻."
          },
          "types": {"type": "integer", "minimum": 0},
          "note": {"type": "string"}
        }
      }
    },
    "_source": {
      "type": "array",
      "description": "이 산출물이 어느 원본에서 나왔는지. 소스마다 한 항목. 고정 불가 소스(AWS CFN zip)는 sha256이 유일한 식별자다 — kbcommon/sources.py 참조.",
      "items": {
        "type": "object",
        "required": [
          "sha256"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "kbcommon/sources.py의 키"
          },
          "pin_kind": {
            "enum": [
              "tag",
              "commit",
              "digest",
              "bundled"
            ]
          },
          "pin": {
            "type": "string",
            "description": "태그명·커밋 SHA. digest 소스는 '(고정 불가)'"
          },
          "url": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "fetched_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_modified": {
            "type": [
              "string",
              "null"
            ]
          },
          "etag": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_file": {
            "type": "boolean"
          },
          "files": {
            "type": "integer",
            "description": "묶음 소스에서 실제로 읽은 파일 수"
          }
        }
      }
    }
  }
}
