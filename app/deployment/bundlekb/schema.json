{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bundlekb 리소스 군 데이터셋",
  "type": "object",
  "required": ["bundles", "cooccurrence"],
  "properties": {
    "bundles": {
      "type": "array",
      "items": { "$ref": "#/$defs/bundle" }
    },
    "cooccurrence": {
      "type": "array",
      "items": { "$ref": "#/$defs/companion" }
    },
    "_coverage": { "type": "array" },
    "_source": { "type": "array" }
  },
  "$defs": {
    "bundle": {
      "type": "object",
      "required": ["id", "name", "provider", "evidence", "members"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "provider": { "type": "string" },
        "evidence": { "type": "string" },
        "anchor": {
          "type": ["string", "null"],
          "description": "이 번들이 무엇을 중심으로 도는가. 대등한 여러 리소스면 null."
        },
        "description": { "type": ["string", "null"] },
        "caveat": {
          "type": ["string", "null"],
          "description": "원본이 스스로 단 경고. 값과 떼어 놓으면 안 된다."
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["typeId", "tier"],
            "additionalProperties": false,
            "properties": {
              "typeId": { "type": "string" },
              "tier": {
                "enum": ["always", "required", "optional"],
                "description": "always=반드시 생김 · required=값을 반드시 줘야 함 · optional=붙일 수 있음"
              },
              "note": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "companion": {
      "type": "object",
      "required": ["anchor", "typeId", "hits", "samples", "evidence"],
      "additionalProperties": false,
      "properties": {
        "anchor": { "type": "string" },
        "typeId": { "type": "string" },
        "hits": { "type": "integer", "minimum": 1 },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "description": "앵커를 담은 템플릿 수. 비율만 담으면 6/17을 35.3%로 읽는다."
        },
        "evidence": { "type": "string" }
      }
    }
  }
}
