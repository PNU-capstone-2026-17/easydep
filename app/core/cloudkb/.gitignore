# 환경 변수 / 시크릿
.env

# uv / 가상환경
.venv/

# Python 캐시
__pycache__/
*.py[cod]
.pytest_cache/

# 지식베이스 빌드 산출물 / 다운로드 캐시
# 재배포하지 않고 각자 원본에서 빌드한다 (costkb는 특히 상위 CSP 데이터라 중요).
output/
# data/ 는 **커밋한다** — 클론 직후 빌드 없이 동작하게 하는 gzip 산출물.
# 재배포 허가 문구가 없는 소스(Azure Retail·IBM Global Catalog)에서 나온 것도
# 넣되, NOTICE와 파일 안 `_note`에 그 사실을 밝힌다.
# `tests/test_redistribution_notice.py`가 그 명시를 강제하고, **명시적으로 막힌**
# 소스(AWS Price List)의 산출물이 들어오는 것도 함께 막는다.
.cache/

# speckb 원본 중 AWS와 GCP는 커밋하지 않는다. 이유가 서로 다르다.
#
# AWS — 약관이 가격 데이터 재배포를 **명시적으로 금지**한다
# (`document/archive/kb-source-atlas-2026-07-29.md`의 `aws-price-list` 항목,
# redistribution="denied"). 문구가 *없는* Azure(`not-stated`)와 다르다.
#
# GCP — machineTypes 응답의 `selfLink`마다 수집에 쓴 프로젝트 ID가 박혀 있다
# (1페이지당 506회). 응답 본문 자체라 지우려면 원본을 고쳐야 하는데, 그러면
# speckb의 무가공 보장이 깨진다. 그래서 원본을 그대로 두고 커밋만 하지 않는다.
#
# 둘 다 `python -m app.core.cloudkb.speckb.fetch_{aws,gcp}` 한 번이면 재생성된다.
speckb/raw/aws/
speckb/raw/gcp/

.claude/worktrees/
token_budget.json
tool_count.json
