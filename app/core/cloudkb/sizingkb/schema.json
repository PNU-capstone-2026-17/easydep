{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sizingkb 사이징 규칙 데이터셋",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "_coverage": { "type": "array" },
    "_source": { "type": "array" }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "kind", "scope", "metric", "value", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": [
            "reserved_ips",
            "minimum",
            "required_count",
            "reference_point",
            "preset"
          ]
        },
        "scope": {
          "type": "string",
          "description": "어디에 걸리는가 — 프로바이더('aws') · 개념('k8s-node') · 워크로드('workload:web')"
        },
        "metric": { "type": "string" },
        "value": { "type": ["number", "string"] },
        "unit": { "type": ["string", "null"] },
        "evidence": { "type": "string" },
        "note": { "type": ["string", "null"] },
        "caveat": {
          "type": ["string", "null"],
          "description": "원본이 스스로 단 경고. 값과 떼면 테스트용 숫자가 권장값이 된다."
        }
      }
    }
  }
}
