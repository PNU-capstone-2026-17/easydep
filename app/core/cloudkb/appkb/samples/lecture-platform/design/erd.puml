@startuml
' ER Diagram for Online Lecture Platform

' ==========================
' Entities
' ==========================
entity "Student" as Student {
  * student_id : UUID <<PK>>
  --
  email : varchar
  password_hash : varchar
  personal_data_location : varchar
  created_at : datetime
}

entity "Instructor" as Instructor {
  * instructor_id : UUID <<PK>>
  --
  email : varchar
  password_hash : varchar
  created_at : datetime
}

entity "Administrator" as Administrator {
  * admin_id : UUID <<PK>>
  --
  email : varchar
  password_hash : varchar
  created_at : datetime
}

entity "Lecture" as Lecture {
  * lecture_id : UUID <<PK>>
  --
  instructor_id : UUID <<FK>>
  title : varchar
  description : text
  price : decimal
  metadata : json
  is_public : boolean
  created_at : datetime
}

entity "Video" as Video {
  * video_id : UUID <<PK>>
  --
  lecture_id : UUID <<FK>>
  file_path : varchar
  format : varchar
  conversion_status : varchar
  created_at : datetime
}

entity "Enrollment" as Enrollment {
  * enrollment_id : UUID <<PK>>
  --
  student_id : UUID <<FK>>
  lecture_id : UUID <<FK>>
  enrollment_date : datetime
  status : varchar
}

entity "PlaybackPosition" as PlaybackPosition {
  * position_id : UUID <<PK>>
  --
  student_id : UUID <<FK>>
  lecture_id : UUID <<FK>>
  position_seconds : decimal
  last_updated : datetime
}

entity "PaymentTransaction" as PaymentTransaction {
  * transaction_id : UUID <<PK>>
  --
  student_id : UUID <<FK>>
  lecture_id : UUID <<FK>>
  amount : decimal
  status : varchar
  timestamp : datetime
}

' ==========================
' Relationships
' ==========================
Student ||--o{ Enrollment : enrolls
Lecture ||--o{ Enrollment : has

Instructor ||--o{ Lecture : creates

Lecture ||--|| Video : has

Student ||--o{ PlaybackPosition : stores
Lecture ||--o{ PlaybackPosition : has

Student ||--o{ PaymentTransaction : pays
Lecture ||--o{ PaymentTransaction : receives

' Optional: Administrator actions are not persisted as separate tables,
' but could be logged in an audit table (not shown here).

@enduml