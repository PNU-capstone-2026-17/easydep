  usecase "View assigned sites" as UC2
  usecase "Create inspection report draft" as UC3
  usecase "Submit completed inspection report" as UC4
  usecase "Browse inspection reports" as UC5
  usecase "View inspection report photos" as UC6
  usecase "Download inspection report PDF" as UC7
  usecase "Flag inspection report for follow‑up" as UC8
  usecase "View follow‑up requests" as UC9
  usecase "Manage engineer accounts" as UC10
  usecase "Assign engineers to sites" as UC11
  usecase "Perform nightly backup of inspection data" as UC12
  usecase "Retrieve selected inspection report" as D1
}
actor "Backup Storage Service" as Backup_Storage_Service
Field_Engineer --- UC1
Field_Engineer --- UC2
Field_Engineer --- UC3
Field_Engineer --- UC4
Field_Engineer --- UC9
Site_Manager --- UC5
Site_Manager --- UC6
Site_Manager --- UC7
Site_Manager --- UC8
Administrator --- UC10
