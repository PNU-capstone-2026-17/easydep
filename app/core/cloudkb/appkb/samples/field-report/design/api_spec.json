  "components": {
    "schemas": {
      "UserAccount": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Unique identifier"
          },
          "username": {
            "type": "string",
            "description": "Login name"
          },
          "passwordHash": {
            "type": "string",
            "description": "Hashed password"
          },
          "role": {
            "type": "string",
            "description": "User role (engineer, admin)"
          },
          "status": {
            "type": "string",
            "description": "Account status (active, deactivated)"
          },
          "assignedSiteIds": {
            "type": "array",
            "items": {},
            "description": "List of site identifiers assigned to the engineer"
          }
        },
        "required": [
          "userId",
          "username",
          "passwordHash",
          "role",
          "status"
        ],
        "description": "Persistent account information for all system users"
      },
      "Site": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "description": "Unique site identifier"
          },
          "name": {
            "type": "string",
            "description": "Site name"
          },
          "location": {
            "type": "string",
            "description": "Geographic location"
          },
          "assignedEngineerIds": {
            "type": "array",
            "items": {},
            "description": "Engineers assigned to the site"
          }
        },
        "required": [
          "siteId",
          "name",
          "location"
        ],
        "description": "Physical location that can be assigned to engineers and linked to inspection reports"
      },
      "InspectionReport": {
        "type": "object",
        "properties": {
          "reportId": {
            "type": "string",
            "description": "Report identifier"
          },
          "siteId": {
            "type": "string",
            "description": "Associated site"
          },
          "engineerId": {
            "type": "string",
            "description": "Engineer who created the report"
          },
          "status": {
            "type": "string",
            "description": "Draft, submitted, etc."
          },
          "checklistData": {
            "type": "object",
            "description": "Checklist contents"
          },
          "photoIds": {
            "type": "array",
            "items": {},
            "description": "Attached photo identifiers"
          },
          "createdAt": {
            "type": "string",
            "description": "Creation timestamp"
          },
          "submittedAt": {
            "type": "string",
            "description": "Submission timestamp"
          },
          "pdfSummaryId": {
            "type": "string",
            "description": "Generated PDF identifier"
          },
          "thumbnailIds": {
            "type": "array",
            "items": {},
            "description": "Generated thumbnail identifiers"
          },
          "followUpFlag": {
            "type": "boolean",
            "description": "Flag for follow‑up"
          }
        },
        "required": [
          "reportId",
          "siteId",
          "engineerId",
          "status",
          "createdAt"
        ],
        "description": "Persistent inspection report, may be draft or submitted"
      },
      "Thumbnail": {
        "type": "object",
        "properties": {
          "thumbnailId": {
            "type": "string",
            "description": "Thumbnail identifier"
          },
          "photoId": {
            "type": "string",
            "description": "Source photo identifier"
          },
          "imageData": {
            "type": "string",
            "description": "Base64‑encoded thumbnail image"
          }
        },
        "required": [
          "thumbnailId",
          "photoId",
          "imageData"
        ],
        "description": "Small image derived from a photo attached to an inspection report"
      },
      "PDFSummary": {
        "type": "object",
        "properties": {
          "pdfId": {
            "type": "string",
            "description": "PDF identifier"
          },
          "reportId": {
