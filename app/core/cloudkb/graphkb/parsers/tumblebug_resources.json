  "D2": "요청 스키마 선택 — 참조 필드이나 필수가 아님",
  "D3": "REST 경로 중첩 — 부모 없이는 주소가 없다",
  "D4": "런타임 존재 확인 — 생성 전 조회 후 실패 시 거부",
  "D5": "삭제 보호 — 참조 카운트가 비어야 삭제된다",
  "D6": "자동 생성 — 없으면 만들어서라도 채운다",
  "D7": "CSP 계약 — cb-spider 중립 인터페이스가 요구",
  "D8": "운영 순서 — 프로젝트 자신의 생성·삭제 순서(**보강 전용**)",
  "D9": "자산 데이터 — `assets/*.yaml`이 프로바이더별로 적어 둔 제약(조건·개수)"
 },
