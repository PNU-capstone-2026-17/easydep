{
  "schemaVersion": "easydep-provider-projection/v1",
  "principle": "중립 개념은 비교 좌표이며 공통 리소스 스키마가 아니다. 벤더별 독립 리소스, 중첩 구성 요소, 다중 리소스 합성을 손실 없이 함께 보존한다.",
  "providers": {
    "aws": {
      "mappings": [
        {"id":"alb","nativePath":"load-balancer","neutralConceptId":"neutral.network-load-balancer","representation":"independent","coverage":"partial","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["aws_lb","aws_alb"]}},
        {"id":"listener","nativePath":"listener","neutralConceptId":"neutral.load-balancer-listener","representation":"independent","coverage":"full","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["aws_lb_listener"]}},
        {"id":"target-group","nativePath":"backend-group","neutralConceptId":"neutral.load-balancer-backend-group","representation":"independent","coverage":"full","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["aws_lb_target_group"]}},
        {"id":"target-group-health","nativePath":"backend-group.healthCheckSettings","neutralConceptId":"neutral.load-balancer-health-check","representation":"embedded","coverage":"partial","ownerResourceId":"target-group","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["aws_lb_target_group"]}},
        {"id":"certificate","nativePath":"certificate","neutralConceptId":"neutral.load-balancer-listener","representation":"independent","coverage":"partial","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["aws_acm_certificate"]}}
      ],
      "realizations": [
        {"id":"http-alb","variant":"인터넷 공개 HTTP Application Load Balancer","capabilityIds":["load-balanced-ingress"],"composition":"multi-resource","mappingIds":["alb","listener","target-group","target-group-health"]},
        {"id":"https-alb","variant":"인터넷 공개 HTTPS Application Load Balancer","capabilityIds":["https-load-balanced-ingress"],"composition":"multi-resource","mappingIds":["alb","listener","target-group","target-group-health","certificate"]}
      ]
    },
    "azure": {
      "mappings": [
        {"id":"gateway","nativePath":"application-gateway","neutralConceptId":"neutral.network-load-balancer","representation":"independent","coverage":"partial","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["azurerm_application_gateway"]}},
        {"id":"listener","nativePath":"application-gateway.http-listener","neutralConceptId":"neutral.load-balancer-listener","representation":"embedded","coverage":"partial","ownerResourceId":"gateway","boundaryStatus":"confirmed","terraformEvidence":{"ownerType":"azurerm_application_gateway","ownerBlock":"http_listener"}},
        {"id":"backend-pool","nativePath":"application-gateway.backend-address-pool","neutralConceptId":"neutral.load-balancer-backend-group","representation":"embedded","coverage":"partial","ownerResourceId":"gateway","boundaryStatus":"confirmed","terraformEvidence":{"ownerType":"azurerm_application_gateway","ownerBlock":"backend_address_pool"}},
        {"id":"backend-settings","nativePath":"application-gateway.backend-http-settings","neutralConceptId":"neutral.load-balancer-backend-group","representation":"embedded","coverage":"partial","ownerResourceId":"gateway","boundaryStatus":"confirmed","terraformEvidence":{"ownerType":"azurerm_application_gateway","ownerBlock":"backend_http_settings"}},
        {"id":"probe","nativePath":"application-gateway.probe","neutralConceptId":"neutral.load-balancer-health-check","representation":"embedded","coverage":"partial","ownerResourceId":"gateway","boundaryStatus":"confirmed","terraformEvidence":{"ownerType":"azurerm_application_gateway","ownerBlock":"probe"}},
        {"id":"routing-rule","nativePath":"application-gateway.request-routing-rule","neutralConceptId":"neutral.load-balancer-listener","representation":"embedded","coverage":"partial","ownerResourceId":"gateway","boundaryStatus":"confirmed","terraformEvidence":{"ownerType":"azurerm_application_gateway","ownerBlock":"request_routing_rule"}},
        {"id":"certificate","nativePath":"application-gateway.ssl-certificate","neutralConceptId":"neutral.load-balancer-listener","representation":"embedded","coverage":"partial","ownerResourceId":"gateway","boundaryStatus":"confirmed","terraformEvidence":{"ownerType":"azurerm_application_gateway","ownerBlock":"ssl_certificate"}},
        {"id":"backend-membership","nativePath":"nic.application-gateway-backend-membership","neutralConceptId":"neutral.load-balancer-backend-group","representation":"independent","coverage":"partial","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["azurerm_network_interface_application_gateway_backend_address_pool_association"]}}
      ],
      "realizations": [
        {"id":"http-application-gateway","variant":"인터넷 공개 HTTP Application Gateway와 VM 백엔드","capabilityIds":["load-balanced-ingress"],"composition":"multi-resource","mappingIds":["gateway","listener","backend-pool","backend-settings","probe","routing-rule","backend-membership"]},
        {"id":"https-application-gateway","variant":"인터넷 공개 HTTPS Application Gateway와 VM 백엔드","capabilityIds":["https-load-balanced-ingress"],"composition":"multi-resource","mappingIds":["gateway","listener","backend-pool","backend-settings","probe","routing-rule","certificate","backend-membership"]}
      ]
    },
    "gcp": {
      "mappings": [
        {"id":"forwarding-rule","nativePath":"forwarding-rule","neutralConceptId":"neutral.network-load-balancer","representation":"composite-member","coverage":"partial","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["google_compute_global_forwarding_rule"]}},
        {"id":"target-http-proxy","nativePath":"target-http-proxy","neutralConceptId":"neutral.load-balancer-listener","representation":"composite-member","coverage":"partial","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["google_compute_target_http_proxy"]}},
        {"id":"target-https-proxy","nativePath":"target-https-proxy","neutralConceptId":"neutral.load-balancer-listener","representation":"composite-member","coverage":"partial","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["google_compute_target_https_proxy"]}},
        {"id":"url-map","nativePath":"url-map","neutralConceptId":"neutral.load-balancer-listener","representation":"composite-member","coverage":"partial","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["google_compute_url_map"]}},
        {"id":"backend-service","nativePath":"backend-service","neutralConceptId":"neutral.load-balancer-backend-group","representation":"composite-member","coverage":"partial","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["google_compute_backend_service"]}},
        {"id":"instance-group","nativePath":"backend-group","neutralConceptId":"neutral.compute-group","representation":"independent","coverage":"full","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["google_compute_instance_group"]}},
        {"id":"health-check","nativePath":"health-check","neutralConceptId":"neutral.load-balancer-health-check","representation":"independent","coverage":"full","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["google_compute_health_check"]}},
        {"id":"certificate","nativePath":"ssl-certificate","neutralConceptId":"neutral.load-balancer-listener","representation":"composite-member","coverage":"partial","boundaryStatus":"confirmed","terraformEvidence":{"resourceTypes":["google_compute_ssl_certificate","google_compute_managed_ssl_certificate"]}}
      ],
      "realizations": [
        {"id":"global-http-alb","variant":"글로벌 외부 HTTP Application Load Balancer와 VM instance group","capabilityIds":["load-balanced-ingress"],"composition":"multi-resource","mappingIds":["forwarding-rule","target-http-proxy","url-map","backend-service","instance-group","health-check"]},
        {"id":"global-https-alb","variant":"글로벌 외부 HTTPS Application Load Balancer와 VM instance group","capabilityIds":["https-load-balanced-ingress"],"composition":"multi-resource","mappingIds":["forwarding-rule","target-https-proxy","url-map","backend-service","instance-group","health-check","certificate"]}
      ]
