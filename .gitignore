# Secrets: real API key and database password live here.
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# os / editor
.DS_Store
.idea/
.vscode/

# PlantUML tool, downloaded separately (17MB binary).
plantuml.jar

# 실행 아티팩트 (재생성 가능) — 보존할 run만 선별 커밋
artifacts/
/.easydep/
/app/implementation/tools/puml2code-bce/node_modules/
/app/implementation/tools/openapi-generator/*.jar
**/.gradle/

# 모델 가중치. 원본 model.safetensors(417MiB)는 GitHub 파일당 100MiB 한도를 넘어
# 커밋할 수 없다.
*.safetensors
# 단, 한도 아래(45MiB)로 쪼개 둔 BERT 샤드는 저장소에 포함한다. 되살린 결과는
# .easydep/models/ 아래에 만들어지므로 위 /.easydep/ 규칙에 걸려 커밋되지 않는다.
# (scripts/shard_bert_model.py, app/requirements/model_assets.py 참고)
!materials/BERT_FR_NFR_Classifier/bert_model/weights/*.safetensors

# 저작권 있는 참고 도서. 프롬프트 근거 자료로 로컬에서만 참고하고 배포하지 않는다.
# (Alistair Cockburn, Writing Effective Use Cases, Addison-Wesley 2001)
materials/Usecase_Knowledge/

# PURE 요구사항 코퍼스. **데이터셋 자체는 CC-BY-4.0**이지만, 큐레이터가 "포함된 요구사항
# 문서들의 IP는 알지 못한다"고 명시한다(Zenodo 10.5281/zenodo.7118517). 위 도서와 같은
# 취급을 한다 — 로컬에서 참조하고 저장소에는 **추출기와 인용만** 둔다.
# 파생 입력(JSON)도 원문 문장을 담으므로 커밋하지 않는다: 기본 출력 경로가 이 아래다.
# (Ferrari, Spagnolo, Gnesi. "PURE: A Dataset of Public Requirements Documents". RE'17)
materials/PURE/

# 배포 에이전트(지식베이스)의 빌드 산출물·캐시. data/ 는 **커밋한다** — 클론 직후
# 빌드 없이 동작하게 하는 gzip 산출물이라 여기 규칙이 없어야 맞다.
# output/ 은 각자 원본에서 빌드하는 결과라 재배포하지 않는다.
/app/deployment/output/
/app/deployment/.cache/
/app/deployment/.claude/
# graphkb build 산출물. 저장소 루트에도 떨어진다(`graphkb build --source cfn|azure|gcp`).
/output/
/app/deployment/token_budget.json
/app/deployment/tool_count.json

# Scratch files and report material, kept out of the project. Anchored to the
# repository root so they cannot swallow real modules such as
# app/requirements/main.py.
/error.puml
/test.py
/main.py
/report/

# 코드를 읽으며 정리한 개인 학습 노트. 코드가 바뀌면 같이 낡으므로 저장소의 진실로
# 삼지 않는다 — 공유할 설명은 각 모듈의 docstring에 둔다.
/note/

# 데모 산출물 — 실행하면 다시 생긴다
app/core/cloudkb/depkb/diagrams/

# 실험 자격증명 — 절대 커밋하지 않는다(kubeconfig·SSH 키·인증서).
app/core/cloudkb/depkb/experiments/**/kubeconfig
app/core/cloudkb/depkb/experiments/**/*.pem
app/core/cloudkb/depkb/experiments/**/id_depkb*
app/core/cloudkb/depkb/experiments/**/ca.crt
