# --- OpenAI 호환 LLM ---
API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BASE_URL=https://integrate.api.nvidia.com/v1
MODEL=openai/gpt-oss-120b
TEMPERATURE=0.2
SEED=42
LLM_MAX_COMPLETION_TOKENS=16384
DESIGN_REASONING_EFFORT=medium
DESIGN_SELECTOR_REASONING_EFFORT=low
REQUIREMENTS_REASONING_EFFORT=medium
REQUIREMENTS_MAX_COMPLETION_TOKENS=8192
DESIGN_CLASS_BEHAVIOR_PARALLELISM=8
DESIGN_CLASS_OPERATION_MAX_COMPLETION_TOKENS=16384

# --- LangSmith observability (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=easydep
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# --- 요구사항 분석 실행 방식 ---
ENABLE_BERT_VERIFY=true
ENABLE_FEEDBACK_GATES=false

# --- 시스템 구현 단계 ---
# 같은 구현 phase에서 출력 경로가 겹치지 않는 LLM 작업의 최대 동시 실행 수입니다.
# API rate limit이 낮은 환경에서는 1로 설정하세요.
IMPLEMENTATION_TASK_PARALLELISM=2
IMPLEMENTATION_AGENT_TEMPERATURE=0.2
IMPLEMENTATION_AGENT_MAX_OUTPUT_TOKENS=16384
IMPLEMENTATION_REASONING_EFFORT=medium
IMPLEMENTATION_REPAIR_REASONING_EFFORT=high
# 서버를 켤 때 별도 Gradle compile까지 미리 실행하려면 true로 바꿉니다.
# 기본 실행은 첫 실제 구현 검사가 필요한 의존성만 받도록 이 작업을 생략합니다.
IMPLEMENTATION_STARTUP_WARMUP=false
# 기본 scaffold의 구현 전 Gradle compile은 생략합니다. 생성기 자체를 점검할 때만 true로 켭니다.
IMPLEMENTATION_VERIFY_INITIAL_COMPILE=false
# OpenHands와 Gradle 실행을 고정 Linux 환경에 둡니다.
# 먼저 `docker build -f docker/member-runner.Dockerfile -t easydep-member-runner:local .`을 실행하세요.
EASYDEP_MEMBER_RUNNER_IMAGE=easydep-member-runner:local

# --- MySQL 산출물 저장소 ---
# 개발 스크립트는 컨테이너의 3306을 호스트의 33060으로 공개한다.
# 백엔드를 직접 실행할 때도 아래 값을 그대로 사용한다.
DB_HOST=127.0.0.1
DB_PORT=33060
DB_USER=root
DB_PASSWORD=easydep-local
DB_NAME=easydep
# true이면 서버 시작 시 DB_NAME의 기존 구조와 데이터를 모두 삭제하고 현재 ORM으로 재생성한다.
# 한 번 초기화한 뒤에는 반드시 false로 되돌린다.
DB_SCHEMA_RESET_ON_START=false
