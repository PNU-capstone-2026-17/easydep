# Copy to .env and fill in. Required for class extraction, feedback correction,
# and OpenAI-compatible artifact generation.
API_KEY=
BASE_URL=https://integrate.api.nvidia.com/v1
DESIGN_AGENT_MODEL=openai/gpt-oss-120b

# MySQL artifact store. The database is created automatically on startup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=easydep
