# 이 파일을 .env로 복사해 값을 채우세요.

# --- Nvidia NIM (OpenAI 호환) 자격증명: 두 에이전트가 공유 ---
API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BASE_URL=https://integrate.api.nvidia.com/v1

# --- 요구사항 분석 에이전트 ---
# 요구사항 분석 에이전트가 쓸 모델. app/requirements/config.py 의 Settings.model.
MODEL=openai/gpt-oss-120b
# EasyDep·CoT·MetaGPT 비교실험이 함께 사용하는 생성 조건.
TEMPERATURE=0
SEED=42
# BERT FR/NFR 검증 노드 사용 여부. false면 torch 로드를 건너뛰고 분류를 생략한다
# (가중치 없이 띄우면 모든 요구사항이 FR로 분류된다 — step1 classify 참고).
ENABLE_BERT_VERIFY=true
# 대화형 게이트(step1 clarify 질문 + 각 스텝 말미 피드백 루프) 사용 여부.
# true면 단계별로 되묻는 대화형, false면 전체 파이프라인을 한 번에 실행(자율).
# 웹 UI에는 영향이 없다 — 화면은 항상 대화형으로 요청한다. CLI/배치 러너의 기본값이다.
ENABLE_FEEDBACK_GATES=false

# --- 시스템 설계 에이전트 ---
# 설계 에이전트가 쓸 모델. 요구사항 쪽 MODEL과 따로 두어 각자 교체할 수 있다.
DESIGN_AGENT_MODEL=openai/gpt-oss-120b
# PlantUML jar used for syntax checking and diagram rendering.
PLANTUML_JAR_PATH=plantuml.jar

# --- MySQL 산출물 저장소 (두 에이전트의 산출물이 모두 여기에 저장된다) ---
# The database is created automatically on startup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=easydep
